# Copy to .env and fill in real values. Never commit .env.

# Groq LLM for the L1 analyst agent. Optional: when empty, the agent has no
# LLM and every incident is escalated to a human (the pipeline still runs).
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Where ChromaDB persists the historical-incident index. A relative path is
# resolved from the directory uvicorn is started in (the repo root, as in the README).
VECTOR_STORE_PATH=data/vectorstore

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
